From 8eef872895bfac18c28711a357519ead78e2dff3 Mon Sep 17 00:00:00 2001
From: Erfan Abdi <erfangplus@gmail.com>
Date: Wed, 31 Jan 2024 17:22:40 +0330
Subject: [PATCH 7/8] ImsService: Switch to shared libs to mtk frameworks

Change-Id: I9d28da23ca7fdfb7a237b69d4624a86d2c096b9f
Signed-off-by: Naveen <133593113+elohim-etz@users.noreply.github.com>
---
 AndroidManifest.xml | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/AndroidManifest.xml b/AndroidManifest.xml
index b5e3651..9d7c956 100644
--- a/AndroidManifest.xml
+++ b/AndroidManifest.xml
@@ -58,6 +58,10 @@
     <application android:allowBackup="false" android:appComponentFactory="androidx.core.app.CoreComponentFactory" android:directBootAware="true" android:extractNativeLibs="false" android:label="ImsApp" android:name="com.mediatek.ims.ImsApp" android:usesNonSdkApi="true">
         <uses-library android:name="com.mediatek.ims.oemplugin" android:required="false"/>
         <uses-library android:name="com.mediatek.ims.plugin" android:required="false"/>
+        <uses-library android:name="mediatek-common" android:required="true"/>
+        <uses-library android:name="mediatek-framework" android:required="true"/>
+        <uses-library android:name="mediatek-ims-base" android:required="true"/>
+        <uses-library android:name="mediatek-ims-oem-plugin" android:required="true"/>
         <receiver android:exported="true" android:name="com.mediatek.ims.MotoDialerReceiver" android:permission="android.permission.READ_PRIVILEGED_PHONE_STATE">
             <intent-filter>
                 <action android:name="com.motorola.internal.intent.action.USER_OPEN_MISSED_CALL"/>
