cc_binary {
    name: "vendor.lineage.touch-service.devonf",
    vintf_fragments: ["vendor.lineage.touch-service.devonf.xml"],
    init_rc: ["vendor.lineage.touch-service.devonf.rc"],
    defaults: ["hidl_defaults"],
    relative_install_path: "hw",
    proprietary: true,
    srcs: [
        "TouchscreenGesture.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libutils",
        "vendor.lineage.touch-V1-ndk",
    ],
}
